# Copy to .env and fill in the three required values. The app reads only a file named
# ".env" next to config.py; this example file is never loaded.
# Lines are KEY=VALUE. Keys are case-insensitive (gemini_api_key works). Real environment
# variables with the same names override this file. " #" starts an inline comment, so a
# value (including your password) cannot contain " #".

# ---- Required (the app refuses to start if any is empty) ----

# Google AI Studio / Gemini API key.
GEMINI_API_KEY=
# Password for the login page and for unlocking the web terminal. Make it long.
APP_PASSWORD=
# Signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# ---- Gemini models ----

# Chat models, tried in order; a model out of quota is skipped (per-minute: 60 s, per-day: until midnight Pacific).
MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-2.5-flash
# Embedding model for memory search. Do not change after first run (stored vectors become incompatible).
EMBED_MODEL=gemini-embedding-2
# Models used for Google-Search-grounded web_search, tried in order.
SEARCH_MODELS=gemini-2.5-flash
# Local per-model cap on Gemini calls per minute; at the cap the next model is used.
RPM_LIMIT=15

# ---- Server ----

# TCP port the web app listens on (all interfaces).
PORT=8765
# IANA timezone for everything shown to you and for reminders / the 02:00 nightly job.
TIMEZONE=Asia/Kolkata

# ---- Claude Code ----

# Seconds one Claude Code turn may run before it is killed.
CLAUDE_TIMEOUT=3600
# Seconds the chat waits for Claude Code before replying "still running" (also the wait for service config changes).
CLAUDE_WAIT=180
# Minutes of inactivity after which a live Claude session is closed (it resumes later with the same conversation).
CLAUDE_IDLE_MIN=30
# Maximum Claude turns running at once (one session per project); others queue.
CLAUDE_MAX_SESSIONS=3
# Directory of Claude Code transcripts that the history sync reads. Default: ~/.claude/projects.
# Use an absolute path ("~" is not expanded). Left commented so the default applies.
# CLAUDE_HISTORY_DIR=/home/you/.claude/projects
# Maximum Gemini calls per Claude history sync run (the rest is deferred 10 minutes).
SYNC_MAX_CALLS=30

# ---- Repo workspace and terminal ----

# Seconds one test run in a cloned repo may take before its process group is killed.
REPO_TEST_TIMEOUT=300
# Minutes without typing before the web terminal locks again.
TERMINAL_IDLE_MIN=30

# ---- Storage ----

# SQLite database file. Default: assistant.db next to main.py. Use an absolute path to move it.
# Left commented so the default applies.
# DB_PATH=/path/to/assistant.db
